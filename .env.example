# Copia este archivo a .env (en la raíz) y rellena los valores reales.
# .env nunca se sube al repo (ver .gitignore). Ver worker/radar/config.py.

# --- Supabase ----------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexión Postgres directa (Settings > Database > Connection string),
# necesaria para pgmq (radar/cola.py) y para psql/supabase CLI.
SUPABASE_DB_URL=

# --- LLM (doc 02 §3: Anthropic u OpenAI; por defecto OpenAI) -------------
# openai | anthropic — gobierna radar/extraccion/llm.py y
# radar/fuentes/buscador_web.py. Solo hace falta rellenar la clave del
# proveedor elegido (la otra puede quedar vacía).
PROVEEDOR_LLM=openai
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Modelos por defecto de OpenAI (verificados 2026-09-11). Si cambias
# PROVEEDOR_LLM a anthropic, cambia esto a algo tipo claude-sonnet-*/claude-haiku-*
# (verificar el vigente en ese momento).
MODELO_PLANIFICADOR=gpt-5.6-sol
MODELO_EXTRACCION=gpt-5.6-luna

# --- Fuentes (D-06, D-07 del registro de decisiones) --------------------
GOOGLE_PLACES_API_KEY=
# openai | anthropic | tavily | exa | serper
SEARCH_API_PROVIDER=openai
SEARCH_API_KEY=

# --- Presupuesto (D-04) --------------------------------------------------
PRESUPUESTO_MENSUAL_EUR=125
PRESUPUESTO_POR_BUSQUEDA_EUR_DEFECTO=20

# --- Caché de descargas web ----------------------------------------------
CACHE_DESCARGAS_DIAS=30
# Carpeta local de radar/extraccion/descarga.py. En un contenedor efímero
# (Railway) no sobrevive a un redeploy — ver docstring de ese módulo.
CACHE_DESCARGAS_DIR=.cache/descargas_web
