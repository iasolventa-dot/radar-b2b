# Copia este archivo a .env (en la raíz) y rellena los valores reales.
# .env nunca se sube al repo (ver .gitignore). Ver worker/radar/config.py.

# --- Supabase ----------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Cadena de conexión Postgres directa (Settings > Database > Connection string),
# necesaria para pgmq (radar/cola.py) y para psql/supabase CLI.
SUPABASE_DB_URL=

# --- LLM (Anthropic / OpenAI opcional) ----------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MODELO_PLANIFICADOR=claude-sonnet-4-5
MODELO_EXTRACCION=claude-haiku-4-5

# --- Fuentes (D-06, D-07 del registro de decisiones) --------------------
GOOGLE_PLACES_API_KEY=
# anthropic | tavily | exa | serper
SEARCH_API_PROVIDER=anthropic
SEARCH_API_KEY=

# --- Presupuesto (D-04) --------------------------------------------------
PRESUPUESTO_MENSUAL_EUR=125
PRESUPUESTO_POR_BUSQUEDA_EUR_DEFECTO=20

# --- Caché de descargas web ----------------------------------------------
CACHE_DESCARGAS_DIAS=30
