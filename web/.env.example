# Copia este archivo a .env.local (nunca subas .env.local a git — ya está
# en .gitignore) y rellena los dos valores desde el dashboard de Supabase:
# Settings -> API Keys.
#
# NEXT_PUBLIC_* es seguro de exponer al navegador: es la clave "publishable"
# (sb_publishable_...), NO la "secret". Este panel nunca usa la clave secreta
# — toda la autorización de lectura/escritura la hace RLS en Postgres
# (supabase/migrations/202609102000_golden_set_revision.sql).

NEXT_PUBLIC_SUPABASE_URL=https://eldawewtpwiepilbwuar.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...

# URL pública del worker (tarea #22, worker/radar/api) desplegado en Railway
# — sin barra final. La usa lib/api.ts SOLO para crear/confirmar una
# búsqueda; el resto de la lectura del panel va directa a Supabase (RLS).
NEXT_PUBLIC_API_URL=https://tu-worker.up.railway.app
